<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Epic.OnlineServices</AssemblyName>
    <RootNamespace>Epic.OnlineServices</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <DefineConstants>EOS_PLATFORM_WINDOWS_64;$(DefineConstants)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\eos-sdk\SDK\Source\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\eos-sdk\SDK\Source\Generated\**\*.cs" Link="Generated\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\eos-sdk\SDK\Source\Overrides\**\*.cs" Link="Overrides\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
